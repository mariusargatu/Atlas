# Copy to .env and fill it in:  cp .env.example .env
#
# OPENAI_API_KEY IS REQUIRED. Nothing else here is.
#
# `just test` and `just ask` run real models: there is one embedding backend and one
# answering backend and both are network services.
#
# Keyless: `just lint`, `just types`, `just report --render`, `just ask --list`, and
# `just up` / `just down`, which only talk to docker. Everything else needs the key.
#
# Every pytest selection needs the key, even the ones that only read the repository:
# tests/conftest.py refuses the whole session when OPENAI_API_KEY is unset, deliberately,
# because one error naming what the suite needs beats a hundred SDK errors naming an
# environment variable. See docs/why-every-run-uses-real-models.md.
#
# This file used to say the opposite, and the stand-ins it named are deleted. See
# docs/why-every-run-uses-real-models.md for what changed and what it cost.


# ---------------------------------------------------------------------------
# Real models. Required by everything that runs the pipeline.
# ---------------------------------------------------------------------------

# Which provider generates answers. "openai" or "anthropic".
# Embeddings are always OpenAI: Anthropic publishes no embeddings endpoint.
MODEL_PROVIDER=openai

# Optional. Overrides MODEL_PROVIDER for the judge specifically, so answer and judge can
# run on different providers in one run rather than sharing the one switch above.
# Defaults to MODEL_PROVIDER when unset. Kept a second environment variable rather than a
# JudgeSettings field on purpose, the same reason MODEL_PROVIDER is one: see
# docs/choosing-models.md.
# JUDGE_MODEL_PROVIDER=anthropic

# Needed for embeddings on either provider, and for generation when MODEL_PROVIDER=openai.
# There is no configuration in which this one is optional.
OPENAI_API_KEY=

# Needed only when MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=


# ---------------------------------------------------------------------------
# Tracing. Optional, and on by default.
# ---------------------------------------------------------------------------
# `just up` starts a local Langfuse stack via docker-compose; `just down` stops it.
# With the stack up, every `just report` is also a Langfuse dataset run, keyed by the same
# run_id as its row in data/results/runs.jsonl. That is a default rather than a flag:
# docs/recording-runs.md.
#
# With these unset, atlas.trace degrades to a no-op decorator and everything still runs,
# so a reader with no container runtime loses nothing but the trace view. Delete the three
# lines below and every command in this repository still works.
#
# Set them and `just report` does two further things: every question's stages become one
# trace, and its measurements are attached to that trace as scores: nDCG, recall, the
# judge's verdict, and how many of the answer's own citations contradict its outcome. That
# last one is why scores are worth attaching at all: spans can show you every request and
# only a score can show you the bad ones.

# These are the keys `just up` provisions the local stack with, so they work as written
# and nothing has to be copied out of a dashboard. They are development credentials for a
# service bound to 127.0.0.1 and are written to look like it.
#
# Live rather than commented out, and that is a correction. They shipped commented, which
# meant the documented first command brought up a Langfuse instance, opened its dashboard,
# and sent it nothing, with no error anywhere, because tracing being off is a supported
# state and looks identical from the outside. Pointing these at a stack that is not
# running is the other failure, and it is the better one: the client complains on flush,
# out loud, and you know within one run which of the two situations you are in.
LANGFUSE_PUBLIC_KEY=pk-lf-0000000000000000000000000000000000000000
LANGFUSE_SECRET_KEY=sk-lf-0000000000000000000000000000000000000000
LANGFUSE_BASE_URL=http://localhost:3000

# Only the web UI is published to the host, on 3000. Set LANGFUSE_PORT if something else
# already holds it, which is likely since 3000 is the most contested port there is,
# and point LANGFUSE_BASE_URL at the same number.
# LANGFUSE_PORT=3100

# LANGFUSE_HOST was the name for LANGFUSE_BASE_URL and is deprecated in the pinned
# release. Named here because following a 2025 tutorial into a silently ignored variable
# is exactly the drift this repository keeps getting caught by.


# ---------------------------------------------------------------------------
# Rarely needed
# ---------------------------------------------------------------------------

# Set to 1 to force huggingface_hub to use its local cache and never reach the network.
# Nothing sets it for you -- an earlier note here said "the offline test sets this itself",
# and that test's monkeypatch was a no-op, because huggingface_hub reads the flag at import
# time. Set it in the environment or not at all. With a cold cache it will fail rather than
# download, which is the point of it.
# HF_HUB_OFFLINE=1
